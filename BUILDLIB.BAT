@ECHO OFF

REM Build base library
C:\TP\BIN\TPC -B -$D- -$E- -$L- LIBRARY\COSTALIB.PAS -ULIBRARY -ILIBRARY -OLIBRARY -E.

REM Build object units
FOR %%F IN (LIBRARY\UI*.PAS) DO C:\TP\BIN\TPC -M -$D- -$E- -$L- %%F -ULIBRARY -ILIBRARY -OLIBRARY -E.

REM Build dialog units
FOR %%F IN (LIBRARY\*DLG.PAS) DO C:\TP\BIN\TPC -M -$D- -$E- -$L- %%F -ULIBRARY -ILIBRARY -OLIBRARY -E.
