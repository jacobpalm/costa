# Make sure "make" utility is available in your PATH before running.
# Built and tested with Borland Make 3.6
#
# To build all applications, run:
#   make
#
# To build only specific applications, run:
#   make COSTA.EXE
#   make DESKTOP.EXE
#   etc.

# Paths for Costa and its source files
COSTADIR   = C:\COSTA
LIBDIR     = $(COSTADIR)\LIBRARY
SOURCEDIR  = $(COSTADIR)\SOURCE

# Compiler settings and paths
TPC = TPC
SWITCHES = -M -$D- -$E- -$L- 
TPCCMD = $(TPC) $(SWITCHES)
BINOBJCMD = BINOBJ

# Compiler paths for library and application source files
LIBPATHS = -U$(LIBDIR) -I$(LIBDIR) -O$(LIBDIR) -E$(COSTADIR)
APPPATHS = -U$(SOURCEDIR) -I$(SOURCEDIR) -O$(SOURCEDIR) -E$(COSTADIR)

# Generate all applications #################################################

ALL: COSTA.EXE DESKTOP.EXE ICONEDIT.EXE MINES.EXE TEXTVIEW.EXE CONFIG.EXE
	@echo.
	@echo All applications built.

# Launcher ##################################################################

COSTA.EXE: $(SOURCEDIR)\COSTA.PAS
	$(TPCCMD) $(SOURCEDIR)\COSTA.PAS $(APPPATHS)

# Desktop ###################################################################

DESKTOP.EXE: $(SOURCEDIR)\DESKTOP.PAS COSTALIB.TPU UIBUTTON.TPU UIDESK.TPU MSGDLG.TPU RUNDLG.TPU ABOUTDLG.TPU FILEDLG.TPU INPUTDLG.TPU DESKEDIT.TPU DESKMENU.TPU
	$(TPCCMD) $(SOURCEDIR)\DESKTOP.PAS $(APPPATHS)

# Desktop Edit Link dialog
DESKEDIT.TPU: $(SOURCEDIR)\DESKEDIT.PAS COSTALIB.TPU UILABEL.TPU UIBUTTON.TPU UIICON.TPU UITXTBOX.TPU UICHKBOX.TPU FILEDLG.TPU MSGDLG.TPU UIDESK.TPU
	$(TPCCMD) $(SOURCEDIR)\DESKEDIT.PAS $(APPPATHS)

# Desktop link menu
DESKMENU.TPU: $(SOURCEDIR)\DESKMENU.PAS COSTALIB.TPU UIBUTTON.TPU UIICON.TPU UILABEL.TPU MSGDLG.TPU DESKEDIT.TPU UIDESK.TPU
	$(TPCCMD) $(SOURCEDIR)\DESKMENU.PAS $(APPPATHS)

# Icon Editor ###############################################################

ICONEDIT.EXE: $(SOURCEDIR)\ICONEDIT.PAS COSTALIB.TPU UIAREA.TPU UIICON.TPU UIBUTTON.TPU UILABEL.TPU UIICONCV.TPU MSGDLG.TPU FILEDLG.TPU INPUTDLG.TPU ABOUTDLG.TPU
	$(TPCCMD) $(SOURCEDIR)\ICONEDIT.PAS $(APPPATHS)

# Minesweeper ###############################################################

MINES.EXE: $(SOURCEDIR)\MINES.PAS COSTALIB.TPU UIMINEFL.TPU UIBUTTON.TPU UILABEL.TPU UITIMER.TPU ABOUTDLG.TPU
	$(TPCCMD) $(SOURCEDIR)\MINES.PAS $(APPPATHS)

# Minefield UI control
UIMINEFL.TPU: $(LIBDIR)\UIMINEFL.PAS COSTALIB.TPU
	$(TPCCMD) $(LIBDIR)\UIMINEFL.PAS $(LIBPATHS)

# Text Viewer ###############################################################

TEXTVIEW.EXE: $(SOURCEDIR)\TEXTVIEW.PAS COSTALIB.TPU UIBUTTON.TPU UITXTBOX.TPU MSGDLG.TPU ABOUTDLG.TPU FILEDLG.TPU
	$(TPCCMD) $(SOURCEDIR)\TEXTVIEW.PAS $(APPPATHS)

# Theme Editor ##############################################################

#THMEDIT.EXE: $(SOURCEDIR)\THMEDIT.PAS COSTALIB.TPU UIBUTTON.TPU UILABEL.TPU UITXTBOX.TPU UIAREA.TPU UIFRAME.TPU UIICON.TPU ABOUTDLG.TPU MSGDLG.TPU INPUTDLG.TPU FILEDLG.TPU
#	$(TPCCMD) $(SOURCEDIR)\THMEDIT.PAS $(APPPATHS)

# Calculator ################################################################

#CALC.EXE: $(SOURCEDIR)\CALC.PAS COSTALIB.TPU UIBUTTON.TPU UIFRAME.TPU UITXTBOX.TPU
#	$(TPCCMD) $(SOURCEDIR)\CALC.PAS $(APPPATHS)

# Tic Tac Toe ###############################################################

#TICTAC.EXE: $(SOURCEDIR)\TICTAC.PAS COSTALIB.TPU UIBUTTON.TPU UIAREA.TPU UIFRAME.TPU
#	$(TPCCMD) $(SOURCEDIR)\TICTAC.PAS $(APPPATHS)

# Configuration Utility #####################################################

CONFIG.EXE: $(SOURCEDIR)\CONFIG.PAS COSTALIB.TPU UIBUTTON.TPU UITXTBOX.TPU UICHKBOX.TPU UILABEL.TPU UIICON.TPU UIFRAME.TPU UITHMPRW.TPU MSGDLG.TPU ABOUTDLG.TPU
	$(TPCCMD) $(SOURCEDIR)\CONFIG.PAS $(APPPATHS)


# Library ###################################################################

# Main library
COSTALIB.TPU: EGADRIV.TPU
	$(TPCCMD) $(LIBDIR)\COSTALIB.PAS -U$(LIBDIR) -I$(LIBDIR) -O$(LIBDIR) -E$(COSTADIR)

# EGA/VGA driver unit
EGADRIV.TPU: $(LIBDIR)\EGADRIV.PAS EGAVGA.OBJ
	$(TPCCMD) $(LIBDIR)\EGADRIV.PAS -E$(COSTADIR)

# Driver object file
EGAVGA.OBJ: $(LIBDIR)\EGAVGA.BGI
	$(BINOBJCMD) $(LIBDIR)\EGAVGA.BGI EGAVGA EGAVGADriverProc

# UI Objects
UIAREA.TPU: $(LIBDIR)\UIAREA.PAS COSTALIB.TPU
	$(TPCCMD) $(LIBDIR)\UIAREA.PAS $(LIBPATHS)

UIBUTTON.TPU: $(LIBDIR)\UIBUTTON.PAS COSTALIB.TPU
	$(TPCCMD) $(LIBDIR)\UIBUTTON.PAS $(LIBPATHS)

UICHKBOX.TPU: $(LIBDIR)\UICHKBOX.PAS COSTALIB.TPU
	$(TPCCMD) $(LIBDIR)\UICHKBOX.PAS $(LIBPATHS)

UIDESK.TPU: $(LIBDIR)\UIDESK.PAS COSTALIB.TPU UIICON.TPU
	$(TPCCMD) $(LIBDIR)\UIDESK.PAS $(LIBPATHS)

UIFRAME.TPU: $(LIBDIR)\UIFRAME.PAS COSTALIB.TPU
	$(TPCCMD) $(LIBDIR)\UIFRAME.PAS $(LIBPATHS)

UIICON.TPU: $(LIBDIR)\UIICON.PAS COSTALIB.TPU
	$(TPCCMD) $(LIBDIR)\UIICON.PAS $(LIBPATHS)

UIICONCV.TPU: $(LIBDIR)\UIICONCV.PAS COSTALIB.TPU UIAREA.TPU UIICON.TPU
	$(TPCCMD) $(LIBDIR)\UIICONCV.PAS $(LIBPATHS)

UILABEL.TPU: $(LIBDIR)\UILABEL.PAS COSTALIB.TPU
	$(TPCCMD) $(LIBDIR)\UILABEL.PAS $(LIBPATHS)

UILIST.TPU: $(LIBDIR)\UILIST.PAS COSTALIB.TPU UIAREA.TPU
	$(TPCCMD) $(LIBDIR)\UILIST.PAS $(LIBPATHS)

UITIMER.TPU: $(LIBDIR)\UITIMER.PAS COSTALIB.TPU
	$(TPCCMD) $(LIBDIR)\UITIMER.PAS $(LIBPATHS)

UITXTBOX.TPU: $(LIBDIR)\UITXTBOX.PAS COSTALIB.TPU
	$(TPCCMD) $(LIBDIR)\UITXTBOX.PAS $(LIBPATHS)

UITHMPRW.TPU: $(LIBDIR)\UITHMPRW.PAS COSTALIB.TPU UIFRAME.TPU UIICON.TPU UITXTBOX.TPU UIBUTTON.TPU UILABEL.TPU MSGDLG.TPU
	$(TPCCMD) $(LIBDIR)\UITHMPRW.PAS $(LIBPATHS)

# Dialogs
ABOUTDLG.TPU: $(LIBDIR)\ABOUTDLG.PAS COSTALIB.TPU UIICON.TPU UIBUTTON.TPU UILABEL.TPU
	$(TPCCMD) $(LIBDIR)\ABOUTDLG.PAS $(LIBPATHS)

FILEDLG.TPU: $(LIBDIR)\FILEDLG.PAS COSTALIB.TPU UIBUTTON.TPU UITXTBOX.TPU UILABEL.TPU UILIST.TPU UIICON.TPU
	$(TPCCMD) $(LIBDIR)\FILEDLG.PAS $(LIBPATHS)

INPUTDLG.TPU: $(LIBDIR)\INPUTDLG.PAS COSTALIB.TPU UIBUTTON.TPU UILABEL.TPU UITXTBOX.TPU
	$(TPCCMD) $(LIBDIR)\INPUTDLG.PAS $(LIBPATHS)

MSGDLG.TPU: $(LIBDIR)\MSGDLG.PAS COSTALIB.TPU UIBUTTON.TPU UILABEL.TPU UIICON.TPU
	$(TPCCMD) $(LIBDIR)\MSGDLG.PAS $(LIBPATHS)

RUNDLG.TPU: $(LIBDIR)\RUNDLG.PAS COSTALIB.TPU UIDESK.TPU UIBUTTON.TPU UITXTBOX.TPU FILEDLG.TPU
	$(TPCCMD) $(LIBDIR)\RUNDLG.PAS $(LIBPATHS)